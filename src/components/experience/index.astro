<section id="experience" class="px-4 py-16 lg:px-20">
  <div class="label mb-4">— professional deployment</div>
  <h2
    class="display text-foreground"
    style={{ fontSize: "clamp(2.5rem, 7vw, 6rem)" }}
  >
    Experience
  </h2>

  <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2">
    <div class="gsap-experience-reveal">
      <div class="label mb-3">— current role</div>
      <h3 class="display text-2xl">Frontend Developer</h3>
      <div class="mt-1 text-xs tracking-widest text-terminal uppercase">
        // full-stack responsibilities
      </div>
      <div class="mt-4">
        <a
          href="https://softvence.agency/"
          target="_blank"
          class="text-xl hover:underline"
        >
          Softvence Agency
          <span class="label-dim"> May 2025 - Present </span>
        </a>
      </div>

      <div class="label-dim mt-6 mb-2">— primary / day-to-day duties</div>
      <ul class="space-y-2 text-sm">
        {
          [
            "Developing pixel-perfect, responsive websites with React, Tailwind CSS, Next, js, Redux Toolkit, Zustand, or other state management tools.",
            "Writing clean, optimized, and cross-browser-compatible code following W3C standards.",
            "Implementing JavaScript and TypeScript to enhance Ul interactivity.",
            "Converting PSD, Figma, and XD designs into HTML with high accuracy.",
            "Integrated REST APIs and optimized frontend performance and data fetching strategies.",
            "Collaborated with backend and design teams to deliver production-ready features.",
            "Understanding client requirements and effectively managing feedback.",
          ].map((t) => (
            <li class="gsap-experience-list flex gap-3 text-muted-foreground">
              <span class="text-terminal">▸</span>
              <span>{t}</span>
            </li>
          ))
        }
      </ul>
      <div class="label-dim mt-8 mb-3">— current projects</div>
      <div class="flex flex-wrap gap-2 text-[10px] tracking-widest uppercase">
        {
          [
            "Admin & billing stack",
            "Vendor architecture",
            "Order Tools",
            "High-performance APIs",
          ].map((t) => (
            <span class="gsap-experience-tag border border-border px-2 py-1 text-muted-foreground transition-colors hover:border-terminal hover:text-terminal cursor-default">
              {t}
            </span>
          ))
        }
      </div>
    </div>

    <div class="gsap-experience-reveal">
      <div class="label mb-3">— skill summary</div>
      <p class="text-sm leading-relaxed text-muted-foreground">
        Working on production-level applications involving frontend systems,
        backend APIs, dashboards, database design, and infrastructure
        deployment.
      </p>
      <div class="label mt-10 mb-3">— development mindset</div>
      <div class="display space-y-2 text-2xl">
        <p>› Clean <span class="text-terminal-dim">Architecture</span></p>
        <p>› Scalable <span class="text-terminal-dim">Systems</span></p>
        <p>› Better <span class="text-terminal-dim">UX</span></p>
      </div>
      <p
        class="mt-6 text-xs leading-relaxed tracking-wider text-muted-foreground uppercase"
      >
        I believe good software is not only about writing code — it's about
        building systems that are maintainable, scalable, performant, and
        user-friendly.
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Reveal columns
  gsap.utils.toArray(".gsap-experience-reveal").forEach((elem: any) => {
    gsap.fromTo(
      elem,
      { y: 50, autoAlpha: 0 },
      {
        y: 0,
        autoAlpha: 1,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: elem,
          start: "top 85%",
        },
      }
    );
  });

  // Stagger list items
  gsap.fromTo(
    ".gsap-experience-list",
    { x: -20, autoAlpha: 0 },
    {
      x: 0,
      autoAlpha: 1,
      duration: 0.5,
      stagger: 0.1,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".gsap-experience-list",
        start: "top 90%",
      },
    }
  );

  // Stagger tags
  gsap.fromTo(
    ".gsap-experience-tag",
    { scale: 0.8, autoAlpha: 0 },
    {
      scale: 1,
      autoAlpha: 1,
      duration: 0.4,
      stagger: 0.05,
      ease: "back.out(1.5)",
      scrollTrigger: {
        trigger: ".gsap-experience-tag",
        start: "top 95%",
      },
    }
  );
</script>
