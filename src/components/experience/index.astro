---
import type { ExperienceCard } from "@/constants/experience"

const base = import.meta.env.DEV ? "http://localhost:4321" : Astro.url.origin
const res = await fetch(`${base}/api/experience`)
const ExperienceData: ExperienceCard[] = await res.json()
---

<section id="experience" class="px-4 py-16 lg:px-20">
  <div class="label mb-4">— professional deployment</div>
  <h2
    class="display text-foreground"
    style={{ fontSize: "clamp(2.5rem, 7vw, 6rem)" }}
  >
    <span class="cursor-target w-fit"> Experience </span>
  </h2>

  <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2">
    <div class="space-y-10">
      {
        ExperienceData.map((section) => (
          <div class="gsap-experience-reveal">
            <div class="label mb-3">{section.label}</div>

            {section.heading && (
              <h3 class="display text-2xl">{section.heading}</h3>
            )}

            {section.subheading && (
              <div class="mt-1 text-xs tracking-widest text-terminal uppercase">
                {section.subheading}
              </div>
            )}

            {section.company && (
              <div class="mt-4">
                <a
                  href={section.company.href}
                  target="_blank"
                  id={section.company.id}
                  data-company={section.company.trackingCompany}
                  class="cursor-target text-xl"
                >
                  {section.company.name}
                  <span class="label-dim"> {section.company.date} </span>
                </a>
              </div>
            )}

            {section.bulletLabel && section.bullets && (
              <>
                <div class="label-dim mt-6 mb-2">{section.bulletLabel}</div>
                <ul class="space-y-2 text-sm">
                  {section.bullets.map((t) => (
                    <li class="gsap-experience-list flex gap-3 text-muted-foreground">
                      <span class="text-terminal">▸</span>
                      <span>{t}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}

            {section.tagLabel && section.tags && (
              <>
                <div class="label-dim mt-8 mb-3">{section.tagLabel}</div>
                <div class="flex flex-wrap gap-2 text-[10px] tracking-widest uppercase">
                  {section.tags.map((t) => (
                    <span class="cursor-target gsap-experience-tag cursor-default border border-border px-2 py-1 text-muted-foreground transition-colors hover:border-terminal hover:text-terminal">
                      {t}
                    </span>
                  ))}
                </div>
              </>
            )}

            {section.description && (
              <p class="text-sm leading-relaxed text-muted-foreground">
                {section.description}
              </p>
            )}

            {section.mindsetLabel && section.mindset && (
              <>
                <div class="label mt-10 mb-3">{section.mindsetLabel}</div>
                <div class="display space-y-2 text-2xl">
                  {section.mindset.map((item) => (
                    <p>
                      {item.prefix}{" "}
                      <span class="text-terminal-dim">{item.emphasis}</span>
                    </p>
                  ))}
                </div>
              </>
            )}

            {section.closing && (
              <p class="mt-6 text-xs leading-relaxed tracking-wider text-muted-foreground uppercase">
                {section.closing}
              </p>
            )}
          </div>
        ))
      }
    </div>

    <div class="gsap-experience-reveal lg:sticky lg:top-4 lg:self-start">
      <div class="label mb-3">— skill summary</div>
      <p class="text-sm leading-relaxed text-muted-foreground">
        Working on production-level applications involving frontend systems,
        backend APIs, dashboards, database design, and infrastructure
        deployment.
      </p>
      <div class="label mt-10 mb-3">— development mindset</div>
      <div class="display space-y-2 text-2xl">
        <p>› Clean <span class="text-terminal-dim">Architecture</span></p>
        <p>› Scalable <span class="text-terminal-dim">Systems</span></p>
        <p>› Better <span class="text-terminal-dim">UX</span></p>
      </div>
      <p
        class="mt-6 text-xs leading-relaxed tracking-wider text-muted-foreground uppercase"
      >
        I believe good software is not only about writing code — it's about
        building systems that are maintainable, scalable, performant, and
        user-friendly.
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  function setupCompanyTracking() {
    const link = document.getElementById("company-link")
    if (!link || link.dataset.trackingBound) return
    link.dataset.trackingBound = "true"
    link.addEventListener("click", () => {
      window.posthog?.capture("company_link_clicked", {
        company: link.dataset.company ?? "softvence_agency",
      })
    })
  }

  document.addEventListener("DOMContentLoaded", setupCompanyTracking)
  document.addEventListener("astro:page-load", setupCompanyTracking)

  // Reveal columns
  gsap.utils.toArray(".gsap-experience-reveal").forEach((elem: any) => {
    gsap.fromTo(
      elem,
      { y: 50, autoAlpha: 0 },
      {
        y: 0,
        autoAlpha: 1,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: elem,
          start: "top 85%",
        },
      }
    )
  })

  // Stagger list items
  gsap.fromTo(
    ".gsap-experience-list",
    { x: -20, autoAlpha: 0 },
    {
      x: 0,
      autoAlpha: 1,
      duration: 0.5,
      stagger: 0.1,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".gsap-experience-list",
        start: "top 90%",
      },
    }
  )

  // Stagger tags
  gsap.fromTo(
    ".gsap-experience-tag",
    { scale: 0.8, autoAlpha: 0 },
    {
      scale: 1,
      autoAlpha: 1,
      duration: 0.4,
      stagger: 0.05,
      ease: "back.out(1.5)",
      scrollTrigger: {
        trigger: ".gsap-experience-tag",
        start: "top 95%",
      },
    }
  )
</script>
