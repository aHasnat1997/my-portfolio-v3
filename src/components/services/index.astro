---
import { Dot } from "lucide-react"
---

<section id="services" class="px-4 py-16 lg:px-20">
  <div class="label mb-4">— system capabilities</div>
  <h2
    class="gsap-services-reveal display mb-16 text-foreground"
    style={{ fontSize: "clamp(2.5rem, 7vw, 6rem)" }}
  >
    Services
  </h2>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
    {
      [
        {
          title: "Frontend Architecture",
          desc: "Building performant, pixel-perfect, and accessible user interfaces using modern frameworks like React, Next.js, and Astro. Ensuring state management is predictable with Redux or Zustand.",
          icon: "01",
        },
        {
          title: "Backend & APIs",
          desc: "Designing scalable server logic, secure authentication, and high-performance RESTful APIs. Specializing in Node.js, Express, and NestJS for resilient backend systems.",
          icon: "02",
        },
        {
          title: "Database Design",
          desc: "Structuring robust, normalized, and optimized data models. Proficient in SQL (PostgreSQL) and NoSQL (MongoDB) databases, utilizing tools like Prisma and Mongoose.",
          icon: "03",
        },
        {
          title: "DevOps & Cloud",
          desc: "Deploying and managing infrastructure to ensure high availability. Experience with Docker containerization, VPS management, cloud storage (S3), and CI/CD pipelines.",
          icon: "04",
        },
      ].map((service) => (
        <div class="gsap-services-card flex flex-col border border-border bg-card/40 p-6 transition-colors hover:border-terminal hover:bg-terminal/5">
          <div class="mb-8 flex items-center justify-between text-terminal">
            <span class="text-2xl font-light">[{service.icon}]</span>
            <Dot className="opacity-50" />
          </div>
          <h3 class="display mb-4 text-xl">{service.title}</h3>
          <p class="text-xs leading-relaxed text-muted-foreground">
            {service.desc}
          </p>
        </div>
      ))
    }
  </div>
</section>

<script>
  import gsap from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  // Reveal heading
  gsap.fromTo(
    ".gsap-services-reveal",
    { y: 50, autoAlpha: 0 },
    {
      y: 0,
      autoAlpha: 1,
      duration: 0.8,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".gsap-services-reveal",
        start: "top 85%",
      },
    }
  )

  // Stagger cards
  gsap.fromTo(
    ".gsap-services-card",
    { y: 40, autoAlpha: 0 },
    {
      y: 0,
      autoAlpha: 1,
      duration: 0.6,
      stagger: 0.15,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".gsap-services-card",
        start: "top 85%",
      },
    }
  )
</script>
