---

---

<section id="contact" class="px-4 py-24 lg:px-20">
  {/* Top label + heading */}
  <div class="mb-16 pb-10">
    <div class="label mb-4">— operative // contact_log</div>
    <div
      class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between"
    >
      <h2
        class="gsap-contact-reveal display text-foreground"
        style={{ fontSize: "clamp(3rem, 8vw, 7rem)" }}
      >
        Let's build<br />
        <span class="text-terminal-dim">something great.</span>
      </h2>
      <!-- <p
        class="gsap-contact-reveal max-w-xs text-xs leading-relaxed tracking-wider text-muted-foreground uppercase lg:text-right"
      >
        Open to full-stack engineering roles,<br />
        freelance projects &amp; product-focused teams.
      </p> -->
    </div>
  </div>

  {/* Main grid */}
  <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1fr_1px_1fr]">
    {/* Left — contact links */}
    <div class="gsap-contact-col space-y-10">
      <div>
        <div class="label mb-6">— direct channels</div>
        <div class="space-y-3">
          {
            [
              {
                label: "email_",
                value: "a.hasnat.dev1@gmail.com",
                href: "mailto:a.hasnat.dev1@gmail.com",
                icon: "✉",
              },
              {
                label: "github_",
                value: "github.com/aHasnat1997",
                href: "https://github.com/aHasnat1997",
                icon: "⌥",
              },
              {
                label: "linkedin_",
                value: "linkedin.com/in/a-hasnat",
                href: "https://linkedin.com/in/a-hasnat",
                icon: "⊙",
              },
            ].map(({ label, value, href, icon }) => (
              <a
                href={href}
                target="_blank"
                rel="noreferrer"
                class="gsap-contact-link group flex items-center gap-5 border border-border bg-card/40 px-5 py-4 transition-all duration-300 hover:border-terminal hover:bg-terminal/5"
              >
                <span class="flex size-9 shrink-0 items-center justify-center border border-border text-lg text-terminal transition-colors group-hover:border-terminal group-hover:bg-terminal/10">
                  {icon}
                </span>
                <div class="flex-1 overflow-hidden">
                  <p class="mb-0.5 text-[10px] tracking-widest text-terminal uppercase">
                    {label}
                  </p>
                  <p class="truncate text-sm tracking-wide text-foreground">
                    {value}
                  </p>
                </div>
                <span class="text-muted-foreground transition-colors group-hover:text-terminal">
                  →
                </span>
              </a>
            ))
          }
        </div>
      </div>

      {/* Availability status */}
      <div class="border border-border bg-card/40 px-5 py-4">
        <div class="mb-3 flex items-center justify-between">
          <span
            class="text-[10px] tracking-widest text-muted-foreground uppercase"
            >// availability_status</span
          >
          <span class="flex items-center gap-1.5">
            <span class="block size-2 animate-pulse rounded-full bg-terminal"
            ></span>
            <span class="text-[10px] tracking-widest text-terminal">OPEN</span>
          </span>
        </div>
        <p class="text-xs leading-relaxed text-muted-foreground">
          Available for remote engagements globally. Response within 24h. Async
          communication preferred.
        </p>
      </div>
    </div>

    {/* Divider */}
    <div class="hidden bg-border lg:block"></div>

    {/* Right — Contact Form */}
    <div class="gsap-contact-col">
      <div class="label mb-6">— send a message</div>

      {/* Success message (hidden by default) */}
      <div id="form-success" class="hidden border border-terminal bg-terminal/10 px-6 py-10 text-center">
        <p class="text-2xl text-terminal display mb-2">[ MESSAGE_SENT ]</p>
        <p class="text-xs text-muted-foreground tracking-widest uppercase">Transmission received. I'll get back to you within 24h.</p>
      </div>

      {/* Error message (hidden by default) */}
      <div id="form-error" class="hidden border border-red-500/50 bg-red-500/10 px-6 py-4 mb-4">
        <p class="text-xs text-red-400 tracking-widest uppercase">// error: transmission failed. please try again.</p>
      </div>

      {/*
        ACTION: Replace "YOUR_FORM_ID" below with your Formspree form ID.
        Go to https://formspree.io → New Form → copy the ID (e.g. xpwzgkjr)
        Then set action="https://formspree.io/f/YOUR_FORM_ID"
      */}
      <form
        id="contact-form"
        action="https://formspree.io/f/YOUR_FORM_ID"
        method="POST"
        class="space-y-4"
        novalidate
      >
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="form-field">
            <label for="contact-name" class="label-dim mb-2 block text-[10px] tracking-widest uppercase">// name_</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="John Doe"
              class="contact-input w-full border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 outline-none transition-colors focus:border-terminal"
            />
          </div>
          <div class="form-field">
            <label for="contact-email" class="label-dim mb-2 block text-[10px] tracking-widest uppercase">// email_</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="john@example.com"
              class="contact-input w-full border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 outline-none transition-colors focus:border-terminal"
            />
          </div>
        </div>

        <div class="form-field">
          <label for="contact-subject" class="label-dim mb-2 block text-[10px] tracking-widest uppercase">// subject_</label>
          <input
            type="text"
            id="contact-subject"
            name="subject"
            required
            placeholder="Project inquiry / Job opportunity / Freelance..."
            class="contact-input w-full border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 outline-none transition-colors focus:border-terminal"
          />
        </div>

        <div class="form-field">
          <label for="contact-message" class="label-dim mb-2 block text-[10px] tracking-widest uppercase">// message_</label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows={6}
            placeholder="Tell me about your project, role, or idea..."
            class="contact-input w-full resize-none border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 outline-none transition-colors focus:border-terminal"
          ></textarea>
        </div>

        <button
          id="contact-submit"
          type="submit"
          class="group relative w-full overflow-hidden border border-terminal bg-terminal/10 py-4 text-center text-xs tracking-[0.3em] text-terminal uppercase transition-all duration-300 hover:bg-terminal/20 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span id="submit-label">[ transmit_message → ]</span>
          <span id="submit-loading" class="hidden animate-pulse">[ transmitting... ]</span>
        </button>
      </form>
    </div>
  </div>
</section>


<script>
  import gsap from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  // Reveal heading
  gsap.utils.toArray(".gsap-contact-reveal").forEach((el: any) => {
    gsap.fromTo(
      el,
      { y: 40, autoAlpha: 0 },
      {
        y: 0,
        autoAlpha: 1,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 90%" },
      }
    )
  })

  // Reveal columns
  gsap.fromTo(
    ".gsap-contact-col",
    { y: 50, autoAlpha: 0 },
    {
      y: 0,
      autoAlpha: 1,
      duration: 0.8,
      stagger: 0.2,
      ease: "power3.out",
      scrollTrigger: { trigger: ".gsap-contact-col", start: "top 88%" },
    }
  )

  // Stagger contact links
  gsap.fromTo(
    ".gsap-contact-link",
    { x: -20, autoAlpha: 0 },
    {
      x: 0,
      autoAlpha: 1,
      duration: 0.5,
      stagger: 0.12,
      ease: "power2.out",
      scrollTrigger: { trigger: ".gsap-contact-link", start: "top 90%" },
    }
  )

  // Focus glow on inputs
  document.querySelectorAll(".contact-input").forEach((input) => {
    input.addEventListener("focus", () => {
      gsap.to(input, { borderColor: "var(--color-terminal)", duration: 0.2 })
    })
    input.addEventListener("blur", () => {
      gsap.to(input, { borderColor: "var(--color-border)", duration: 0.3 })
    })
  })

  // Form submission via fetch (no page redirect)
  const form = document.getElementById("contact-form") as HTMLFormElement
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement
  const submitLabel = document.getElementById("submit-label")!
  const submitLoading = document.getElementById("submit-loading")!
  const successMsg = document.getElementById("form-success")!
  const errorMsg = document.getElementById("form-error")!

  form?.addEventListener("submit", async (e) => {
    e.preventDefault()

    // Basic client-side validation
    const inputs = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea[required]")
    let valid = true
    inputs.forEach((input) => {
      if (!input.value.trim()) {
        valid = false
        gsap.fromTo(input, { x: -6 }, { x: 0, duration: 0.4, ease: "elastic.out(1, 0.3)" })
        gsap.to(input, { borderColor: "rgba(239,68,68,0.7)", duration: 0.2, yoyo: true, repeat: 1 })
      }
    })
    if (!valid) return

    // Show loading state
    submitBtn.disabled = true
    submitLabel.classList.add("hidden")
    submitLoading.classList.remove("hidden")
    errorMsg.classList.add("hidden")

    try {
      const data = new FormData(form)
      const res = await fetch(form.action, {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      })

      if (res.ok) {
        // Success
        form.classList.add("hidden")
        gsap.fromTo(successMsg, { y: 20, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.6, ease: "power3.out" })
        successMsg.classList.remove("hidden")
      } else {
        throw new Error("Server error")
      }
    } catch {
      errorMsg.classList.remove("hidden")
      gsap.fromTo(errorMsg, { y: -10, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.4 })
      submitBtn.disabled = false
      submitLabel.classList.remove("hidden")
      submitLoading.classList.add("hidden")
    }
  })
</script>

