---
import { Dot } from "lucide-react"
---

<section
  id="contact"
  class="grid grid-cols-1 gap-12 border-b border-border px-4 py-16 lg:grid-cols-2 lg:px-20"
>
  <div>
    <div class="label mb-4">— operative // contact_log</div>
    <h2 class="display" style={{ fontSize: "clamp(2.5rem, 6vw, 5rem)" }}>
      Let's build
      <br />
      something
      <br />
      <span class="text-terminal-dim">great.</span>
    </h2>

    <dl class="mt-10 space-y-3 text-sm">
      {
        [
          ["email_", "a.hasnat.dev1@gmail.com"],
          ["github_", "github.com/aHasnat1997"],
          ["linkedin_", "linkedin.com/in/a-hasnat"],
        ].map(([k, v]) => (
          <div class="grid grid-cols-[100px_1fr] items-center gap-4 border border-border bg-card/40 px-3 py-2">
            <dt class="text-[10px] tracking-widest text-terminal uppercase">
              {k}
            </dt>
            <dd class="text-xs tracking-wider text-foreground uppercase">
              {v}
            </dd>
          </div>
        ))
      }
    </dl>
    <p
      class="cursor-blink mt-6 text-[10px] tracking-widest text-muted-foreground uppercase"
    >
      status_ Last log out: 13:42:08 UTC // system synchronized // ready &gt;
      project rebrief incoming
    </p>
  </div>

  <div>
    <div class="label mb-4">— availability profile</div>
    <ul class="space-y-2 text-sm">
      {
        [
          "Full Stack Developer roles",
          "Frontend Engineering roles",
          "Product-focused engineering teams",
        ].map((t) => (
          <li class="flex items-center gap-3 border border-border bg-card/40 px-3 py-3">
            <Dot />
            <span class="tracking-wider uppercase">{t}</span>
          </li>
        ))
      }
    </ul>

    <a
      href="mailto:z.hasnat.dev@gmail.com"
      class="mt-6 block border border-terminal bg-terminal/10 py-4 text-center text-xs tracking-[0.3em] text-terminal uppercase transition-colors hover:bg-terminal/20"
    >
      [ initiate_contact_sequence ]
    </a>

    <div class="label-dim mt-10 mb-2">— transmission frequency</div>
    <p
      class="text-xs leading-relaxed tracking-wider text-muted-foreground uppercase"
    >
      I respond within 24 hours. Asynchronous comms preferred. Available for
      remote engagements globally.
    </p>
  </div>
</section>
