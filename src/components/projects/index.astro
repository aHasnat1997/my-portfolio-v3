---
import { ProjectsData } from "@/constants/projects"
---

<section id="projects" class="px-4 py-16 lg:px-20">
  <div class="label mb-4">— operative deployments</div>
  <h2
    class="gsap-project-reveal display mb-16 text-foreground"
    style={{ fontSize: "clamp(2.5rem, 7vw, 6rem)" }}
  >
    Featured Projects
  </h2>

  <div class="flex flex-col items-start gap-10 lg:flex-row">
    <ul class="projects-list w-full lg:w-[60%] space-y-16 pb-32">
      {
        ProjectsData.map((p, i) => (
          <li 
            class="gsap-project-card panel mx-auto flex flex-col transition-all duration-300 md:sticky bg-background border border-border md:shadow-[0_-10px_30px_-10px_rgba(0,0,0,0.5)]" 
            style={`top: calc(1rem + ${i * 1.5}rem); z-index: ${i + 1};`}
            data-index={i}
          >
            <div class="flex h-full flex-col p-8 bg-background">
              <div class="label">{p.tag}</div>
              <h3 class="display mt-4 text-xl leading-tight">{p.title}</h3>
              <p class="mt-2 text-[11px] tracking-widest text-terminal-dim uppercase">
                {p.blurb}
              </p>
              <p class="mt-4 text-xs leading-relaxed text-muted-foreground">
                {p.desc}
              </p>

              <div class="label-dim mt-5 mb-2">// tech</div>
              <div class="flex flex-wrap gap-1.5">
                {p.stack.map((s) => (
                  <span class="border border-border px-1.5 py-0.5 text-[10px] text-foreground">
                    {s}
                  </span>
                ))}
              </div>

              <div class="label-dim mt-5 mb-2">// key_features</div>
              <ul class="mb-8 space-y-1.5 text-xs text-muted-foreground">
                {p.features.map((f) => (
                  <li class="flex gap-2">
                    <span class="text-terminal">›</span>
                    {f}
                  </li>
                ))}
              </ul>

              <a
                href={`/projects/${p.id}`}
                class="mt-auto block w-full border border-border py-2.5 text-center text-[11px] tracking-widest text-foreground uppercase transition-colors hover:border-terminal hover:text-terminal"
              >
                [ view_project ]
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    {/* Technical log */}
    <div class="gsap-tech-log mx-auto mt-16 w-full md:mt-0 lg:sticky lg:top-4 lg:w-[35%]">
      <div>
        <h3 class="display text-3xl">Technical Log</h3>
        <p
          class="mt-3 text-[11px] tracking-widest text-muted-foreground uppercase"
        >
          Technical specs of all operative capabilities and system fundamentals.
        </p>
      </div>
      <div class="panel divide-y divide-border">
        <div
          class="grid grid-cols-[160px_1fr_80px] px-4 py-2 text-[10px] tracking-widest text-terminal-dim uppercase"
        >
          <span class="text-nowrap">// system_type</span>
          <span class="text-nowrap">// primary_stack</span>
        </div>
        {
          [
            [
              "[frontend_dev]",
              "React.js // Next.js // Astro // JavaScript // TypeScript // Tailwind CSS // Zustand // Redux",
            ],
            [
              "[backend_dev]",
              "Node.js // Nest.js // Express.js // REST API // Auth & Authorization // Role-based access control",
            ],
            [
              "[databases_dev]",
              "PostgreSQL // MongoDB // Prisma ORM // Mongoose // SQL & NoSQL Database Design",
            ],
            [
              "[devops_basic]",
              "Docker // Git // VPS // File Storage Systems // S3 & Cloudinary // Deployment Pipelines",
            ],
          ].map(([type, stack]) => (
            <div class="gsap-tech-item grid grid-cols-[160px_1fr_80px] px-4 py-3 text-xs transition-colors hover:bg-terminal/5">
              <span class="text-terminal">{type}</span>
              <span class="text-muted-foreground">{stack}</span>
            </div>
          ))
        }
        <!-- <button
          class="w-full px-4 py-3 text-[11px] tracking-widest text-muted-foreground uppercase hover:text-terminal"
        >
          + load full archive
        </button> -->
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Reveal heading
  gsap.fromTo(
    ".gsap-project-reveal",
    { y: 50, autoAlpha: 0 },
    {
      y: 0,
      autoAlpha: 1,
      duration: 0.8,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".gsap-project-reveal",
        start: "top 85%",
      },
    }
  );

  // Stagger project cards entrance
  gsap.fromTo(
    ".gsap-project-card",
    { y: 100, autoAlpha: 0 },
    {
      y: 0,
      autoAlpha: 1,
      duration: 0.8,
      stagger: 0.2,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".projects-list",
        start: "top 80%",
      },
    }
  );

  // CSS sticky handles the stacking perfectly, we just stagger their entrance.

  // Tech log reveal
  gsap.fromTo(
    ".gsap-tech-log",
    { x: 30, autoAlpha: 0 },
    {
      x: 0,
      autoAlpha: 1,
      duration: 0.8,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".gsap-tech-log",
        start: "top 85%",
      },
    }
  );

  // Tech log items stagger
  gsap.fromTo(
    ".gsap-tech-item",
    { x: 20, autoAlpha: 0 },
    {
      x: 0,
      autoAlpha: 1,
      duration: 0.5,
      stagger: 0.1,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".gsap-tech-log",
        start: "top 80%",
      },
    }
  );
</script>
