---
const apiKey = import.meta.env.PUBLIC_WAKATIME_API_KEY
const encoded = btoa(apiKey + ":")

let data: any = null
let error = false

try {
  const res = await fetch(
    "https://wakatime.com/api/v1/users/current/stats/last_year",
    { headers: { Authorization: `Basic ${encoded}` } }
  )
  const json = await res.json()
  if (json.data) data = json.data
  else error = true
} catch {
  error = true
}

const totalHours = Math.floor((data?.total_seconds ?? 0) / 3600)
const totalMins = Math.floor(((data?.total_seconds ?? 0) % 3600) / 60)
const dailyAvg = data?.daily_average
  ? `${Math.floor(data.daily_average / 3600)}h ${Math.floor((data.daily_average % 3600) / 60)}m`
  : "—"
const topLangs = data?.languages?.slice(0, 6) ?? []
const topEditors = data?.editors ?? []
const topOS = data?.operating_systems ?? []
const topCategories = data?.categories?.slice(0, 4) ?? []
const bestDay = data?.best_day
---

<section class="px-4 py-16 lg:px-20">
  <div class="label mb-4">— activity telemetry</div>
  <h2
    class="display text-foreground"
    style="font-size: clamp(2.5rem, 7vw, 6rem)"
  >
    Code Stats
  </h2>
  <p class="mt-3 text-[11px] tracking-widest text-muted-foreground uppercase">
    // powered by wakatime // last_year data
  </p>

  {
    error ? (
      <p class="mt-6 text-xs tracking-widest text-muted-foreground uppercase">
        // failed to load wakatime data
      </p>
    ) : (
      <div class="mt-12 space-y-10">
        {/* — stat summary row */}
        <div class="grid grid-cols-1 gap-px border border-border bg-border sm:grid-cols-1">
          {[
            {
              label: "// total_coded",
              value:
                `${totalHours}h ${totalMins}m` +
                " " +
                "from" +
                " " +
                (bestDay?.date || "—"),
            },

            // { label: "// daily_avg", value: dailyAvg },
            // {
            //   label: "// languages",
            //   value: String(data?.languages?.length ?? "—"),
            // },
            // {
            //   label: "// projects",
            //   value: String(data?.projects?.length ?? "—"),
            // },
          ].map((s) => (
            <div class="flex flex-col gap-1 bg-background px-5 py-4">
              <span class="label-dim">{s.label}</span>
              <span class="display text-xl text-terminal md:text-3xl">
                {s.value}
              </span>
            </div>
          ))}
        </div>

        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
          {/* — languages */}
          <div>
            <div class="label mb-6">— languages</div>
            <ul class="space-y-4">
              {topLangs.map((lang: any) => (
                <li>
                  <div class="mb-1 flex items-center justify-between text-xs tracking-widest uppercase">
                    <div class="flex items-center gap-2">
                      <span class="text-terminal">›</span>
                      <span>{lang.name}</span>
                    </div>
                    <div class="flex items-center gap-4 text-muted-foreground">
                      <span>{lang.text}</span>
                      <span class="w-10 text-right text-terminal">
                        {lang.percent.toFixed(1)}%
                      </span>
                    </div>
                  </div>
                  <div class="h-0.5 w-full bg-border">
                    <div
                      class="h-full bg-terminal transition-all"
                      style={`width: ${lang.percent}%`}
                    />
                  </div>
                </li>
              ))}
            </ul>
          </div>

          {/* — right column: editors + os + best day + categories */}
          <div class="space-y-8">
            {/* best day */}
            {/* {bestDay && (
              <div class="grid grid-cols-2 gap-px border border-border bg-border">
                <div class="flex flex-col gap-1 bg-background px-5 py-4">
                  <span class="label-dim">// best_day</span>
                  <span class="display text-2xl text-terminal">
                    {bestDay.text}
                  </span>
                </div>
                <div class="flex flex-col gap-1 bg-background px-5 py-4">
                  <span class="label-dim">// date</span>
                  <span class="display text-2xl text-terminal-dim">
                    {bestDay.date}
                  </span>
                </div>
              </div>
            )} */}

            {/* editors */}
            <div>
              <div class="label mb-4">— editors</div>
              <div class="panel divide-y divide-border">
                {topEditors.map((e: any) => (
                  <div class="flex items-center justify-between px-4 py-3 text-xs tracking-widest uppercase">
                    <div class="flex items-center gap-3">
                      <span class="text-terminal">▸</span>
                      <span>{e.name}</span>
                    </div>
                    <div class="flex items-center gap-4 text-muted-foreground">
                      <span>{e.text}</span>
                      <span class="text-terminal">{e.percent.toFixed(1)}%</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            {/* os */}
            {topOS.length > 0 && (
              <div>
                <div class="label mb-4">— operating systems</div>
                <div class="panel divide-y divide-border">
                  {topOS.map((os: any) => (
                    <div class="flex items-center justify-between px-4 py-3 text-xs tracking-widest uppercase">
                      <div class="flex items-center gap-3">
                        <span class="text-terminal">▸</span>
                        <span>{os.name}</span>
                      </div>
                      <div class="flex items-center gap-4 text-muted-foreground">
                        <span>{os.text}</span>
                        <span class="text-terminal">
                          {os.percent.toFixed(1)}%
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* categories
            {topCategories.length > 0 && (
              <div>
                <div class="label mb-4">— activity breakdown</div>
                <ul class="space-y-3">
                  {topCategories.map((c: any) => (
                    <li>
                      <div class="mb-1 flex items-center justify-between text-xs tracking-widest uppercase">
                        <div class="flex items-center gap-2">
                          <span class="text-terminal">›</span>
                          <span>{c.name}</span>
                        </div>
                        <div class="flex items-center gap-4 text-muted-foreground">
                          <span>{c.text}</span>
                          <span class="w-10 text-right text-terminal">
                            {c.percent.toFixed(1)}%
                          </span>
                        </div>
                      </div>
                      <div class="h-0.5 w-full bg-border">
                        <div
                          class="h-full bg-terminal-dim"
                          style={`width: ${c.percent}%`}
                        />
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )} */}
          </div>
        </div>
      </div>
    )
  }
</section>
