---
import MainLayout from "@/layouts/main.astro"
import { Dot } from "lucide-react"
import Hero from "@/components/hero/index.astro"
import About from "@/components/about/index.astro"
import Experience from "@/components/experience/index.astro"
import Projects from "@/components/projects/index.astro"
import Services from "@/components/services/index.astro"
import Workflow from "@/components/workflow/index.astro"
import WakaTime from "@/components/wakatime/index.astro"
import Contact from "@/components/contact/index.astro"
---

<MainLayout>
  <main class="min-h-screen">
    {/* Top status bar */}
    <div class="border-b border-border">
      <div
        class="mx-auto flex items-center justify-between px-4 py-2 text-[10px] tracking-[0.2em] text-muted-foreground uppercase lg:px-20"
      >
        <div class="flex items-center gap-3">
          <Dot />
          <span>system://hasnat.dev</span>
          <span class="hidden sm:inline"
            >// portfolio.build // full_stack_developer</span
          >
        </div>
        <!-- <div class="flex items-center gap-3">
          <span>online</span>
          <span class="rounded-sm bg-terminal/10 px-1.5 py-0.5 text-terminal"
            >GMT+6</span
          >
        </div> -->
      </div>
    </div>

    <div class="mx-auto space-y-20">
      <Hero />
      <About />
      <Services />
      <Experience />
      <Projects />
      <Workflow />
      <!-- <WakaTime /> -->
      <Contact />
    </div>

    {/* Bottom footer bar */}
    <div class="mt-16 flex flex-col items-center gap-2 py-8 text-center">
      <p
        class="cursor-blink text-[10px] tracking-widest text-muted-foreground uppercase"
      >
        system synchronized // all channels active // ready &gt; project rebrief
        incoming
      </p>
      <p class="text-[10px] tracking-widest text-terminal-dim uppercase">
        © {new Date().getFullYear()} A. Hasnat — All rights reserved.
      </p>
    </div>
  </main>
</MainLayout>
